{
  "name": "prism-media-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PRISM 棱镜 — a daily global feminist & LGBTQIA+ deep-reporting, research and fact-checking platform (interactive prototype).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-demo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "tsc --noEmit && node scripts/validate-demo.mjs && node scripts/smoke.mjs",
    "ui-check": "node scripts/ui-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
